<!--
    MantisBT PHPUnit configuration
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"

    bootstrap="tests/bootstrap.php"
    colors="true"
    displayDetailsOnAllIssues="true"
    failOnAllIssues="true"
    >

    <testsuites>
        <testsuite name="mantis">
            <directory>tests/Mantis</directory>
        </testsuite>

        <testsuite name="soap">
            <directory>tests/soap</directory>
        </testsuite>

        <testsuite name="rest">
            <directory>tests/rest</directory>
        </testsuite>

        <testsuite name="mantis core formatting">
            <directory>plugins/MantisCoreFormatting/tests</directory>
        </testsuite>
    </testsuites>

</phpunit>
